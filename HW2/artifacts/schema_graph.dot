digraph Schema {
  rankdir=LR;
  graph [fontname="Helvetica", nodesep=0.5, ranksep=1.1, bgcolor=white];
  node  [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge  [color="#555555", arrowsize=0.8, penwidth=1.1];
  Users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1f3b63"><FONT COLOR="white"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id" BGCOLOR="#fdf3d7">user_id  <FONT COLOR="#b8860b"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="github_user_id" BGCOLOR="white">github_user_id</TD></TR><TR><TD ALIGN="LEFT" PORT="login" BGCOLOR="white">login</TD></TR><TR><TD ALIGN="LEFT" PORT="is_bot" BGCOLOR="white">is_bot</TD></TR><TR><TD ALIGN="LEFT" PORT="is_cohort" BGCOLOR="white">is_cohort</TD></TR><TR><TD ALIGN="LEFT" PORT="first_seen_at" BGCOLOR="white">first_seen_at</TD></TR></TABLE>>];
  Repositories [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1f3b63"><FONT COLOR="white"><B>Repositories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="repo_id" BGCOLOR="#fdf3d7">repo_id  <FONT COLOR="#b8860b"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="github_repo_id" BGCOLOR="white">github_repo_id</TD></TR><TR><TD ALIGN="LEFT" PORT="name" BGCOLOR="white">name</TD></TR><TR><TD ALIGN="LEFT" PORT="owner_login" BGCOLOR="white">owner_login</TD></TR><TR><TD ALIGN="LEFT" PORT="org_id" BGCOLOR="white">org_id</TD></TR><TR><TD ALIGN="LEFT" PORT="org_login" BGCOLOR="white">org_login</TD></TR><TR><TD ALIGN="LEFT" PORT="first_seen_at" BGCOLOR="white">first_seen_at</TD></TR></TABLE>>];
  PullRequests [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1f3b63"><FONT COLOR="white"><B>PullRequests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pr_id" BGCOLOR="#fdf3d7">pr_id  <FONT COLOR="#b8860b"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="repo_id" BGCOLOR="#eef7ee">repo_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="author_id" BGCOLOR="#eef7ee">author_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="merged_by_id" BGCOLOR="#eef7ee">merged_by_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="white">created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="merged_at" BGCOLOR="white">merged_at</TD></TR><TR><TD ALIGN="LEFT" PORT="closed_at" BGCOLOR="white">closed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="first_seen_at" BGCOLOR="white">first_seen_at</TD></TR></TABLE>>];
  Issues [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1f3b63"><FONT COLOR="white"><B>Issues</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="issue_id" BGCOLOR="#fdf3d7">issue_id  <FONT COLOR="#b8860b"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="repo_id" BGCOLOR="#eef7ee">repo_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="author_id" BGCOLOR="#eef7ee">author_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_pull_request" BGCOLOR="white">is_pull_request</TD></TR><TR><TD ALIGN="LEFT" PORT="pull_request_id" BGCOLOR="#eef7ee">pull_request_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="assignee_id" BGCOLOR="#eef7ee">assignee_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="white">created_at</TD></TR><TR><TD ALIGN="LEFT" PORT="closed_at" BGCOLOR="white">closed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="first_seen_at" BGCOLOR="white">first_seen_at</TD></TR></TABLE>>];
  IssueComments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1f3b63"><FONT COLOR="white"><B>IssueComments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="comment_id" BGCOLOR="#fdf3d7">comment_id  <FONT COLOR="#b8860b"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="issue_id" BGCOLOR="#eef7ee">issue_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="repo_id" BGCOLOR="#eef7ee">repo_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="author_id" BGCOLOR="#eef7ee">author_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_pull_request" BGCOLOR="white">is_pull_request</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="white">created_at</TD></TR></TABLE>>];
  PRReviews [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1f3b63"><FONT COLOR="white"><B>PRReviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="review_id" BGCOLOR="#fdf3d7">review_id  <FONT COLOR="#b8860b"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pr_id" BGCOLOR="#eef7ee">pr_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="repo_id" BGCOLOR="#eef7ee">repo_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reviewer_id" BGCOLOR="#eef7ee">reviewer_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="state" BGCOLOR="white">state</TD></TR><TR><TD ALIGN="LEFT" PORT="submitted_at" BGCOLOR="white">submitted_at</TD></TR><TR><TD ALIGN="LEFT" PORT="dismissed_at" BGCOLOR="white">dismissed_at</TD></TR><TR><TD ALIGN="LEFT" PORT="first_seen_at" BGCOLOR="white">first_seen_at</TD></TR></TABLE>>];
  PRReviewComments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1f3b63"><FONT COLOR="white"><B>PRReviewComments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="comment_id" BGCOLOR="#fdf3d7">comment_id  <FONT COLOR="#b8860b"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pr_id" BGCOLOR="#eef7ee">pr_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="repo_id" BGCOLOR="#eef7ee">repo_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="author_id" BGCOLOR="#eef7ee">author_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pull_request_review_id" BGCOLOR="#eef7ee">pull_request_review_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="in_reply_to_id" BGCOLOR="#eef7ee">in_reply_to_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="white">created_at</TD></TR></TABLE>>];
  Pushes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1f3b63"><FONT COLOR="white"><B>Pushes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="push_id" BGCOLOR="#fdf3d7">push_id  <FONT COLOR="#b8860b"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id" BGCOLOR="#eef7ee">user_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="repo_id" BGCOLOR="#eef7ee">repo_id  <FONT COLOR="#2a7">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ref_type" BGCOLOR="white">ref_type</TD></TR><TR><TD ALIGN="LEFT" PORT="is_new_ref" BGCOLOR="white">is_new_ref</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" BGCOLOR="white">created_at</TD></TR></TABLE>>];
  PullRequests:repo_id -> Repositories:repo_id;
  PullRequests:author_id -> Users:user_id;
  PullRequests:merged_by_id -> Users:user_id;
  Issues:repo_id -> Repositories:repo_id;
  Issues:author_id -> Users:user_id;
  Issues:pull_request_id -> PullRequests:pr_id;
  Issues:assignee_id -> Users:user_id;
  IssueComments:issue_id -> Issues:issue_id;
  IssueComments:repo_id -> Repositories:repo_id;
  IssueComments:author_id -> Users:user_id;
  PRReviews:pr_id -> PullRequests:pr_id;
  PRReviews:repo_id -> Repositories:repo_id;
  PRReviews:reviewer_id -> Users:user_id;
  PRReviewComments:pr_id -> PullRequests:pr_id;
  PRReviewComments:repo_id -> Repositories:repo_id;
  PRReviewComments:author_id -> Users:user_id;
  PRReviewComments:pull_request_review_id -> PRReviews:review_id;
  PRReviewComments:in_reply_to_id -> PRReviewComments:comment_id [style=dashed];
  Pushes:user_id -> Users:user_id;
  Pushes:repo_id -> Repositories:repo_id;
}